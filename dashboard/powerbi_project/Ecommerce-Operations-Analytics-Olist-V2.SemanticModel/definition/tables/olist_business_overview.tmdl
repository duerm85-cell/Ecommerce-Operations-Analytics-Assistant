	column as_of_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: df214f46-56d9-bf56-c820-b279b95535e9
		summarizeBy: none
		sourceColumn: as_of_date

		annotation UnderlyingDateTimeDataType = Date

	column order_scope
