/// Olist all-time KPI snapshot; delivered orders are the sales scope and monetary values are BRL.
table olist_business_overview
	lineageTag: 5d044129-169b-3569-244c-a85c33ec06a3

	column snapshot_id
		dataType: string
		isHidden
		lineageTag: 50c7f0f9-abe6-6035-78cf-789990ab4cbf
		summarizeBy: none
