/// Delivered-order category performance mart with item value, freight and attributed order-level review metrics.
table olist_category_performance
	lineageTag: 9fce51da-3682-bd75-354e-9e788ccf585e

	column category_id
		dataType: string
		isHidden
		lineageTag: 303be31b-7cf0-49c4-5a90-5f3ccf6416a1
		summarizeBy: none
		sourceColumn: category_id

	column category_pt
		dataType: string
		lineageTag: 7604f8ea-dd62-fb05-1b80-5c195ca49f79
		summarizeBy: none
		sourceColumn: category_pt

	column category_en
		dataType: string
		lineageTag: 221a8504-8ae8-7320-0b53-0f236211737e
		summarizeBy: none
		sourceColumn: category_en

	column category_display_name
		dataType: string
		lineageTag: d041da19-47c7-c304-6da6-69d048bfceab
		summarizeBy: none
		sourceColumn: category_display_name

	column category_translation_status
		dataType: string
		lineageTag: ae6f82f9-efe5-9526-0cba-0b7feaa030d0
		summarizeBy: none
