		formatString: 0.00%
		lineageTag: 6c02cf35-d5f4-6aed-c269-e1de5e319d0d
		summarizeBy: average
		sourceColumn: freight_ratio

	column average_review_score
		dataType: double
		formatString: 0.00
		lineageTag: 1d92c582-fd96-00c8-5ee0-de5578924a42
		summarizeBy: average
		sourceColumn: average_review_score

	column low_rating_rate
		dataType: double
		formatString: 0.00%
		lineageTag: 15c5c065-f209-3f37-d84e-e927c71597f1
		summarizeBy: average
		sourceColumn: low_rating_rate

	column currency_code
		dataType: string
		isHidden
		lineageTag: 890361a9-71eb-e400-73bd-8b69c9692dbf
		summarizeBy: none
		sourceColumn: currency_code

	column data_mode
		dataType: string
		isHidden
		lineageTag: 7a14f8d9-5cea-ae6e-369e-bfac5ee49a45
		summarizeBy: none
		sourceColumn: data_mode

	column _analytics_build_id
		dataType: string
		isHidden
		lineageTag: f2a1c568-fdb0-325c-c5b2-a95251c5ebc0
		summarizeBy: none
