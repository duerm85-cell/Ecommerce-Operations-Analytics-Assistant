		summarizeBy: sum
		sourceColumn: units_sold

	column merchandise_gmv_brl
		dataType: double
		formatString: #,0.00 "BRL"
		lineageTag: 1d0e6670-b234-6f15-2986-228b80b8444f
		summarizeBy: sum
		sourceColumn: merchandise_gmv_brl

	column average_item_price_brl
		dataType: double
		formatString: #,0.00 "BRL"
		lineageTag: 2bbc5a79-627d-d3cb-030c-56b0d72d176d
		summarizeBy: average
		sourceColumn: average_item_price_brl

	column freight_value_brl
		dataType: double
		formatString: #,0.00 "BRL"
		lineageTag: a6f13bf1-be56-b8dd-a49f-be4fb9415c01
		summarizeBy: sum
		sourceColumn: freight_value_brl

	column freight_ratio
