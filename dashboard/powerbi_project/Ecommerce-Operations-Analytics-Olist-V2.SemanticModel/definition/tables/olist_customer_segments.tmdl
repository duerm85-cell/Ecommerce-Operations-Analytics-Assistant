/// RFM segment summary derived from customer_unique_id-level customer values.
table olist_customer_segments
	lineageTag: 7bb1a611-d673-6915-edea-52365f6255a8

	column rfm_segment
		dataType: string
		lineageTag: d621b93c-4b20-c775-c7f0-015b764b33f1
		summarizeBy: none
		sourceColumn: rfm_segment

	column customers
		dataType: int64
		formatString: #,0
		lineageTag: 1b34fb65-3b21-4e24-b5d6-3e0594ae27cb
		summarizeBy: sum
		sourceColumn: customers

	column repeat_customers
		dataType: int64
		formatString: #,0
		lineageTag: 16f2aa55-16ca-c39d-5de9-3505c2cb5b3e
		summarizeBy: sum
		sourceColumn: repeat_customers

	column repeat_purchase_rate
