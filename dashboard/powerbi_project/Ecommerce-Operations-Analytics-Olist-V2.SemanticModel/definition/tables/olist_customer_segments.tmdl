	column _analytics_build_id
		dataType: string
		isHidden
		lineageTag: da2e5182-94cf-63de-d95d-4e49c0c0b929
		summarizeBy: none
		sourceColumn: _analytics_build_id

	column _built_at
		dataType: string
		isHidden
		lineageTag: affabdfc-0ef6-b57f-6447-4bfa44a7e435
		summarizeBy: none
		sourceColumn: _built_at

	partition olist_customer_segments = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataRoot & "\olist_customer_segments.csv"), [Delimiter=",", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"rfm_segment", type text}, {"customers", Int64.Type}, {"repeat_customers", Int64.Type}, {"repeat_purchase_rate", type number}, {"average_recency_days", type number}, {"average_frequency", type number}, {"total_monetary_value_brl", type number}, {"average_monetary_value_brl", type number}, {"customer_share", type number}, {"currency_code", type text}, {"data_mode", type text}, {"_analytics_build_id", type text}, {"_built_at", type text}}, "en-US")
				in
				    #"Changed Type"
