		formatString: 0.00%
		lineageTag: a2601e71-3705-3933-5962-b596e892aa00
		summarizeBy: average
		sourceColumn: repeat_purchase_rate

	column average_recency_days
		dataType: double
		formatString: 0.00
		lineageTag: 79c3340d-8873-064c-c07f-1c016a17602b
		summarizeBy: average
		sourceColumn: average_recency_days

	column average_frequency
		dataType: double
		formatString: 0.00
		lineageTag: dd907880-4e2e-e2e6-d25c-8151ccac654b
		summarizeBy: average
		sourceColumn: average_frequency

	column total_monetary_value_brl
		dataType: double
		formatString: #,0.00 "BRL"
		lineageTag: bab35272-0885-f397-2965-68b3de131de1
		summarizeBy: sum
		sourceColumn: total_monetary_value_brl

	column average_monetary_value_brl
		dataType: double
		formatString: #,0.00 "BRL"
		lineageTag: 50793544-72b0-d791-5500-57c7f0afe907
		summarizeBy: average
		sourceColumn: average_monetary_value_brl

	column customer_share
		dataType: double
		formatString: 0.00%
		lineageTag: 312df181-f1a6-8f0c-090e-f72ce8cb78df
		summarizeBy: average
		sourceColumn: customer_share

	column currency_code
		dataType: string
		isHidden
		lineageTag: 2ded53c0-1fc6-880e-cd59-c8eab84fb9b9
		summarizeBy: none
		sourceColumn: currency_code

	column data_mode
		dataType: string
		isHidden
